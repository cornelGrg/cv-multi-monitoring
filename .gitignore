# Python virtual environment and cache
venv/
__pycache__/
*.py[cod]
*$py.class

# IDEs and Tools
.vscode/
.idea/
.antigravity-ide/
.gemini/
artifacts/

# Data and Archives
data/raw/
data/processed/
outputs/
*.engine
*.onnx

# Model weights and TensorRT engines
models/*.pt
models/*.onnx
models/*.engine
models/*.trt

# Voluminous output files (metrics, logs, events)
outputs/*
